<ClickerGUI>:
    orientation: 'horizontal'
    padding: 10
    spacing: 10
    
    # Контейнер для анимации
    BoxLayout:
        id: main_screen
        orientation: 'vertical'
        size_hint_x: 0.75
        spacing: 5
        
        # Контейнер для анимации
        BoxLayout:
            id: anim_container
            size_hint_y: 0.6
            canvas.before:
                Color:
                    rgba: 0.94, 0.94, 0.94, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            
            Canvas:
                id: animation_canvas
                size: self.size
                pos: self.pos
        
        # Игровой фрейм
        BoxLayout:
            id: game_frame
            orientation: 'vertical'
            size_hint_y: 0.4
            
            Label:
                id: label_result
                text: ''
                font_size: 14
                color: 0, 0, 0, 1
                size_hint_y: 0.4
            
            BoxLayout:
                size_hint_y: 0.6
                spacing: 20
                padding: [20, 0, 20, 10]
                
                Button:
                    id: button_click
                    text: root.translations[root.current_lang]['start_challenge']
                    font_size: 14
                    size_hint_x: 0.6
                    background_color: 0.678, 0.847, 1, 1
                    on_release: root.start_challenge()
                
                Label:
                    id: label_points
                    text: root.translations[root.current_lang]['points'].format(root.game.get_points())
                    font_size: 16
                    bold: True
                    size_hint_x: 0.4
    
    # Правая панель с кнопками
    BoxLayout:
        id: right_buttons
        orientation: 'vertical'
        size_hint_x: 0.25
        spacing: 5
        padding: [0, 5, 0, 5]
        
        Button:
            id: btn_inventory
            text: root.translations[root.current_lang]['btn_inventory']
            background_color: 1, 0.6, 0.6, 1
            font_size: 10
            bold: True
            on_release: root.open_inventory()
        
        Button:
            id: btn_shop
            text: root.translations[root.current_lang]['btn_shop']
            background_color: 0.6, 1, 0.6, 1
            font_size: 10
            bold: True
            on_release: root.open_shop()
        
        Button:
            id: btn_authors
            text: root.translations[root.current_lang]['btn_authors']
            background_color: 1, 1, 0.6, 1
            font_size: 10
            bold: True
            on_release: root.open_authors()
        
        Button:
            id: btn_language
            text: root.translations[root.current_lang]['menu_lang']
            background_color: 0.678, 0.847, 1, 1
            font_size: 10
            bold: True
            on_release: root.show_language_menu()
        
        Button:
            id: btn_settings
            text: root.translations[root.current_lang]['btn_settings']
            background_color: 0.8, 0.8, 0.8, 1
            font_size: 10
            bold: True
            on_release: root.open_settings()
    
    # Кнопка назад (скрыта по умолчанию)
    Button:
        id: back_button
        text: root.translations[root.current_lang]['back']
        font_size: 12
        bold: True
        background_color: 0.678, 0.847, 1, 1
        size_hint_x: 0.25
        opacity: 0
        disabled: True
        pos_hint: {'x': 0.75, 'y': 0}
        on_release: root.close_current_screen()


# Экран инвентаря
<InventoryScreen@BoxLayout>:
    opacity: 0
    disabled: True
    orientation: 'vertical'
    padding: 10
    spacing: 10
    
    Label:
        id: inventory_title
        text: root.translations[root.current_lang]['inventory']
        font_size: 16
        bold: True
        size_hint_y: 0.1
    
    BoxLayout:
        id: potion_frame
        orientation: 'vertical'
        size_hint_y: 0.4
        padding: 10
        spacing: 5
        canvas.before:
            Color:
                rgba: 1, 1, 0.6, 1
            Rectangle:
                pos: self.pos
                size: self.size
            Color:
                rgba: 1, 0.84, 0, 1
            Line:
                rectangle: self.x, self.y, self.width, self.height
                width: 2
        
        BoxLayout:
            size_hint_y: 0.7
            spacing: 10
            
            Image:
                id: potion_image
                source: 'images/potionthatgives2xcoins.png'
                size_hint_x: 0.3
            
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.7
                spacing: 5
                
                Label:
                    text: root.translations[root.current_lang]['potion']
                    font_size: 10
                    bold: True
                    halign: 'left'
                    text_size: self.width, None
                
                Button:
                    id: potion_button
                    text: root.translations[root.current_lang]['potion_inactive']
                    font_size: 9
                    size_hint_y: 0.5
                    on_release: root.use_potion()
        
        Label:
            id: potion_status
            text: root.translations[root.current_lang]['potion_inactive']
            font_size: 9
            color: 0.5, 0.5, 0.5, 1
            size_hint_y: 0.3
            halign: 'left'
            text_size: self.width, None


# Экран магазина
<ShopScreen@BoxLayout>:
    opacity: 0
    disabled: True
    orientation: 'vertical'
    padding: 10
    spacing: 10
    
    Label:
        id: shop_title
        text: root.translations[root.current_lang]['btn_shop']
        font_size: 16
        bold: True
        size_hint_y: 0.1
    
    Label:
        id: shop_closed_label
        text: root.translations[root.current_lang]['shop_closed']
        font_size: 12
        color: 0.5, 0.5, 0.5, 1
        size_hint_y: 0.9


# Экран авторов
<AuthorsScreen@BoxLayout>:
    opacity: 0
    disabled: True
    orientation: 'vertical'
    padding: 10
    spacing: 10
    
    Label:
        id: authors_title
        text: root.translations[root.current_lang]['btn_authors']
        font_size: 16
        bold: True
        size_hint_y: 0.1
    
    Label:
        text: '🎮 Authors:\n\n• thekosmoss\n• artman\n• amonpys\n\n🔧 Проект: Basketball click\n📅 2026 © GlitchHunters'
        font_size: 11
        halign: 'center'
        valign: 'center'
        color: 0, 0, 0, 1
        text_size: self.width, None


# Экран настроек
<SettingsScreen@BoxLayout>:
    opacity: 0
    disabled: True
    orientation: 'vertical'
    padding: 10
    spacing: 10
    
    Label:
        text: 'Settings'
        font_size: 16
        bold: True
        size_hint_y: 0.1
    
    Label:
        text: 'Настройки в разработке'
        font_size: 12
        color: 0.5, 0.5, 0.5, 1
        size_hint_y: 0.9